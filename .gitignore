# 打包产物（build.bat 生成，不入库）
dist/
*.exe
*.exe~

# 运行时数据（配置、会话 SVG、模型库缓存）
data/

# 临时工作目录与测试产物
.tmp/
.smoke/
.playwright-cli/
output/

# 历史备份（.backup-vNN / internal.bak 是手工快照，不入库）
.backup-v*/
internal.bak/
.selfcheck/

# 编辑器 / 系统杂项
*.lock
.DS_Store
Thumbs.db

# 编辑器 / IDE 本地配置
.idea/
.vscode/
*.swp
*~
*.orig
*.bak
*.tmp

# 日志与临时转储
*.log
nohup.out

# Go 测试与覆盖率产物
*.test
*.out
coverage.*

# 前端 / Playwright 产物
node_modules/
test-results/
playwright-report/

# 环境变量（含密钥，绝不入库）
.env
.env.*
